#!/usr/bin/env bash
# `gh` that rides out GitHub API 5xx bursts (2026-10-03: ~20 min of intermittent 503s failed two
# TestFlight runs and dropped a watch app). Retries ONLY when gh's error says HTTP 5xx; anything else
# (a 4xx, a workflow run that failed) returns at once with gh's own exit code. stderr is shown after
# each attempt. Stdin isn't replayed, so a retried call that was fed on stdin fails fast instead.
# ponytail: a dispatch whose 5xx hid a success starts a second run on retry; callers watch the newest.
err=$(mktemp); trap 'rm -f "$err"' EXIT
for wait in 15 30 60 120 180 300 300 0; do
  gh "$@" 2>"$err"; rc=$?
  cat "$err" >&2
  [ $rc -eq 0 ] && exit 0
  { [ "$wait" -gt 0 ] && grep -qE 'HTTP 5[0-9]{2}' "$err"; } || exit $rc
  echo "gh-retry: GitHub returned a 5xx, retrying in ${wait}s" >&2
  sleep "$wait"
done
