#!/usr/bin/env python3
"""Print the usbmux address of whichever machine currently has the iPhone plugged in.

The phone moves between machines (a laptop, a desktop, or straight into this box), and every tool here
needs USBMUXD_SOCKET_ADDRESS pointed at the right one. Rather than hardcode a host, probe each
candidate and pick the one that actually reports a device.

  export USBMUXD_SOCKET_ADDRESS=$(ios-host)   # what ios-ota does
  ios-host --all                              # show every candidate and what it sees

Candidates come from ~/.config/ios-drive.conf: `usbmux_hosts = a:27015, b:27015` (a pinned
`usbmux = host:port` wins outright). The local /var/run/usbmuxd socket is always tried too, so a
directly-plugged phone needs no config at all.
"""
import os, pathlib, plistlib, socket, struct, sys

CONF = pathlib.Path(os.environ.get("IOS_DRIVE_CONF", pathlib.Path.home() / ".config/ios-drive.conf"))
LOCAL = "/var/run/usbmuxd"


def conf(key):
    env = os.environ.get("IOS_DRIVE_" + key.upper())
    if env:
        return env
    if CONF.exists():
        for line in CONF.read_text().splitlines():
            line = line.split("#")[0]
            if "=" in line:
                k, v = line.split("=", 1)
                if k.strip() == key and v.strip():
                    return v.strip()
    return None


def devices(addr, timeout=2.0):
    """usbmux ListDevices, spoken directly so a probe costs milliseconds instead of a
    pymobiledevice3 process launch (~3s) per candidate."""
    try:
        if ":" in addr:
            host, port = addr.rsplit(":", 1)
            s = socket.create_connection((host, int(port)), timeout=timeout)
        else:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(timeout)
            s.connect(addr)
        with s:
            req = plistlib.dumps({"MessageType": "ListDevices",
                                  "ClientVersionString": "ios-host", "ProgName": "ios-host"})
            s.sendall(struct.pack("<IIII", 16 + len(req), 1, 8, 1) + req)
            head = s.recv(16)
            if len(head) < 16:
                return []
            body = b""
            want = struct.unpack("<I", head[:4])[0] - 16
            while len(body) < want:
                chunk = s.recv(want - len(body))
                if not chunk:
                    break
                body += chunk
            return plistlib.loads(body).get("DeviceList", [])
    except (OSError, ValueError, plistlib.InvalidFileException):
        return []


def candidates():
    pinned = os.environ.get("USBMUXD_SOCKET_ADDRESS") or conf("usbmux")
    if pinned:
        return [pinned]
    hosts = [h.strip() for h in (conf("usbmux_hosts") or "").replace(",", " ").split() if h.strip()]
    return [LOCAL] + hosts


def main() -> int:
    show_all = "--all" in sys.argv
    found = None
    for addr in candidates():
        devs = devices(addr)
        if show_all:
            names = ", ".join(d.get("Properties", {}).get("SerialNumber", "?") for d in devs)
            print(f"{addr:28s} {len(devs)} device(s) {names}")
        if devs and found is None:
            found = addr
            if not show_all:
                break
    if found is None:
        if not show_all:
            print("ios-host: no iPhone found on any usbmux host "
                  f"({', '.join(candidates())})", file=sys.stderr)
        return 1
    if not show_all:
        print(found)
    return 0


if __name__ == "__main__":
    sys.exit(main())
